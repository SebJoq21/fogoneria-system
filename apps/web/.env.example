# URL base de la API Fogonería (NestJS). En dev corre en el puerto 3001.
# El prefijo /api/v1 ya viene incluido en este valor. Solo la usan el BFF y el
# login en el servidor; el navegador nunca llama directo a la API.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Secreto para firmar la cookie de sesión HttpOnly (mínimo 32 caracteres).
# OBLIGATORIO en staging/producción. En development/test se usa un fallback.
# Genera uno con: openssl rand -base64 32
SESSION_SECRET=""

# Opcional: límite de intentos de login por IP (por defecto 5 / 10 min).
SESSION_RATE_LIMIT="5"
SESSION_RATE_WINDOW_MS="600000"
