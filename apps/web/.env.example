# URL base de la API Fogonería (NestJS). En dev corre en el puerto 3001.
# El prefijo /api/v1 ya viene incluido en este valor.
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"

# Secreto para firmar la cookie de sesión HttpOnly (mínimo 32 caracteres).
# Genera uno con: openssl rand -base64 32
SESSION_SECRET="dev-only-session-secret-change-me-32chars"
