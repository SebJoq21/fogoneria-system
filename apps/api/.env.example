# PostgreSQL local (docker compose en la raíz del repo)
DATABASE_URL="postgresql://fogoneria_app:fogoneria_app@localhost:5432/fogoneria_db?schema=fogoneria"
# Base auxiliar para `prisma migrate dev`
SHADOW_DATABASE_URL="postgresql://fogoneria_app:fogoneria_app@localhost:5432/fogoneria_shadow?schema=fogoneria"
