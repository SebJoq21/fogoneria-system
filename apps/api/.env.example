# PostgreSQL local (docker compose en la raíz del repo)
# Si cambias POSTGRES_PORT, actualiza también el puerto de estas dos URLs.
DATABASE_URL="postgresql://fogoneria_app:fogoneria_app@localhost:5433/fogoneria_db?schema=fogoneria"
# Base auxiliar para `prisma migrate dev`
SHADOW_DATABASE_URL="postgresql://fogoneria_app:fogoneria_app@localhost:5433/fogoneria_shadow?schema=fogoneria"

# Docker Compose (defaults del compose; se pueden sobreescribir en un .env de la raíz)
POSTGRES_DB=fogoneria_db
POSTGRES_USER=fogoneria_app
POSTGRES_PASSWORD=fogoneria_app
POSTGRES_PORT=5433

# Esquema de Prisma
DATABASE_SCHEMA="fogoneria"

# Servidor
PORT=3001
CORS_ORIGIN="http://localhost:3000"

# Auth JWT (en producción: mínimo 32 caracteres)
JWT_SECRET="dev-only-jwt-secret-change-me-32-chars"
JWT_EXPIRES_IN="8h"

# Consola SaaS
TRIAL_DAYS=14
BILLING_GRACE_DAYS=5
