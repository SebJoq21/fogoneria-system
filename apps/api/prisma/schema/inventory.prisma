// Esquema Prisma del modulo inventory.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model escandallos_recetas {
  plato_id           String  @db.Uuid
  insumo_id          String  @db.Uuid
  cantidad_por_plato Decimal @db.Decimal(12, 3)
  unidad             String  @default("kg")
  insumos            insumos @relation(fields: [insumo_id], references: [id], map: "fk_esc_insumo")
  platos             platos  @relation(fields: [plato_id], references: [id], onDelete: Cascade, map: "fk_esc_plato")

  @@id([plato_id, insumo_id])
  @@index([insumo_id], map: "idx_esc_insumo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model insumos {
  id                     String                   @id(map: "pk_insumos") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id             String                   @db.Uuid
  proveedor_id           String?                  @db.Uuid
  nombre                 String
  categoria              String?
  unidad                 String                   @default("kg")
  costo_promedio         Decimal                  @default(0) @db.Decimal(12, 2)
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at             DateTime                 @default(now()) @db.Timestamptz(6)
  deleted_at             DateTime?                @db.Timestamptz(6)
  deleted_by             String?                  @db.Uuid
  alertas_stock          alertas_stock[]
  escandallos_recetas    escandallos_recetas[]
  empresas               empresas                 @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_insumos_empresa")
  proveedores            proveedores?             @relation(fields: [proveedor_id], references: [id], map: "fk_insumos_proveedor")
  movimientos_inventario movimientos_inventario[]
  stocks_sucursal        stocks_sucursal[]

  @@unique([empresa_id, nombre], map: "uq_insumos_empresa_nombre", where: raw("deleted_at IS NULL"))
  @@index([empresa_id], map: "idx_insumos_empresa")
  @@index([proveedor_id], map: "idx_insumos_proveedor")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model movimientos_inventario {
  id               String                     @id(map: "pk_movinv") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id       String                     @db.Uuid
  sucursal_id      String                     @db.Uuid
  insumo_id        String                     @db.Uuid
  tipo             tipo_movimiento_inventario
  cantidad         Decimal                    @db.Decimal(12, 3)
  stock_resultante Decimal?                   @db.Decimal(12, 3)
  motivo           String?
  orden_id         String?                    @db.Uuid
  actor_id         String?                    @db.Uuid
  created_at       DateTime                   @default(now()) @db.Timestamptz(6)
  usuarios         usuarios?                  @relation(fields: [actor_id], references: [id], map: "fk_movinv_actor")
  empresas         empresas                   @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_movinv_empresa")
  insumos          insumos                    @relation(fields: [insumo_id], references: [id], map: "fk_movinv_insumo")
  ordenes          ordenes?                   @relation(fields: [orden_id], references: [id], map: "fk_movinv_orden")
  sucursales       sucursales                 @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_movinv_sucursal")

  @@index([empresa_id], map: "idx_movinv_empresa")
  @@index([insumo_id], map: "idx_movinv_insumo")
  @@index([orden_id], map: "idx_movinv_orden")
  @@index([sucursal_id], map: "idx_movinv_sucursal")
  @@index([empresa_id, sucursal_id, insumo_id, created_at(sort: Desc)], map: "idx_movinv_tenant_insumo_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model proveedores {
  id         String    @id(map: "pk_proveedores") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id String    @db.Uuid
  nombre     String
  ruc        String?   @db.VarChar(11)
  telefono   String?
  rubro      String?
  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at DateTime? @db.Timestamptz(6)
  deleted_by String?   @db.Uuid
  gastos     gastos[]
  insumos    insumos[]
  empresas   empresas  @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_proveedores_empresa")

  @@unique([empresa_id, nombre], map: "uq_proveedores_empresa_nombre", where: raw("deleted_at IS NULL"))
  @@index([empresa_id], map: "idx_proveedores_empresa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model stocks_sucursal {
  sucursal_id  String     @db.Uuid
  insumo_id    String     @db.Uuid
  empresa_id   String     @db.Uuid
  cantidad     Decimal    @default(0) @db.Decimal(12, 2)
  stock_minimo Decimal    @default(0) @db.Decimal(12, 2)
  updated_at   DateTime   @default(now()) @db.Timestamptz(6)
  empresas     empresas   @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_stock_empresa")
  insumos      insumos    @relation(fields: [insumo_id], references: [id], onDelete: Cascade, map: "fk_stock_insumo")
  sucursales   sucursales @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_stock_sucursal")

  @@id([sucursal_id, insumo_id])
  @@index([empresa_id], map: "idx_stock_empresa")
  @@index([insumo_id], map: "idx_stock_insumo")
}

enum tipo_movimiento_inventario {
  ENTRADA
  SALIDA
  AJUSTE
  MERMA
}

/// AYCDS-13: alerta vigente por insumo y sucursal (se borra al reponer).
model alertas_stock {
  id            String    @id(map: "pk_alertas_stock") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id    String    @db.Uuid
  sucursal_id   String    @db.Uuid
  insumo_id     String    @db.Uuid
  estado        String
  cantidad      Decimal   @db.Decimal(12, 3)
  stock_minimo  Decimal   @db.Decimal(12, 3)
  notificado_at DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @db.Timestamptz(6)
  empresas      empresas  @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_alertas_empresa")
  insumos       insumos   @relation(fields: [insumo_id], references: [id], onDelete: Cascade, map: "fk_alertas_insumo")
  sucursales    sucursales @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_alertas_sucursal")

  @@unique([sucursal_id, insumo_id], map: "uq_alertas_stock")
  @@index([empresa_id, sucursal_id, estado], map: "idx_alertas_tenant")
}
