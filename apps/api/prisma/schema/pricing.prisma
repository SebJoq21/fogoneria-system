// Esquema Prisma del modulo pricing.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model listas_precios {
  id             String           @id(map: "pk_listas") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id     String           @db.Uuid
  nombre         String
  activa         Boolean          @default(false)
  vigencia_desde DateTime?        @db.Date
  vigencia_hasta DateTime?        @db.Date
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?        @db.Timestamptz(6)
  deleted_by     String?          @db.Uuid
  empresas       empresas         @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_listas_empresa")
  ordenes        ordenes[]
  precios_platos precios_platos[]

  @@unique([empresa_id, nombre], map: "uq_listas_empresa_nombre", where: raw("deleted_at IS NULL"))
  @@index([empresa_id], map: "idx_listas_empresa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model precios_platos {
  lista_id       String         @db.Uuid
  plato_id       String         @db.Uuid
  precio         Decimal        @db.Decimal(12, 2)
  listas_precios listas_precios @relation(fields: [lista_id], references: [id], onDelete: Cascade, map: "fk_precios_lista")
  platos         platos         @relation(fields: [plato_id], references: [id], onDelete: Cascade, map: "fk_precios_plato")

  @@id([lista_id, plato_id])
  @@index([plato_id], map: "idx_precios_plato")
}
