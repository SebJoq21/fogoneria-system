// Esquema Prisma del modulo billing.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model suscripciones_eventos {
  id               String           @id(map: "pk_suscripciones") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id       String           @db.Uuid
  plan             plan_suscripcion
  estado_anterior  estado_empresa?
  estado_nuevo     estado_empresa
  motivo           String?
  mrr_antes        Decimal?         @db.Decimal(12, 2)
  mrr_despues      Decimal?         @db.Decimal(12, 2)
  actor_usuario_id String?          @db.Uuid
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  usuarios         usuarios?        @relation(fields: [actor_usuario_id], references: [id], map: "fk_suscripciones_actor")
  empresas         empresas         @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_suscripciones_empresa")

  @@index([empresa_id], map: "idx_suscripciones_empresa")
}
