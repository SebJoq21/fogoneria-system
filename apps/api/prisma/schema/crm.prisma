// Esquema Prisma del modulo crm.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model clientes {
  id                 String               @id(map: "pk_clientes") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id         String               @db.Uuid
  nombre             String
  telefono           String
  segmento           segmento_cliente     @default(NUEVO)
  visitas            Int                  @default(0)
  puntos             Int                  @default(0)
  ultima_visita      DateTime?            @db.Date
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  deleted_at         DateTime?            @db.Timestamptz(6)
  deleted_by         String?              @db.Uuid
  empresas           empresas             @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_clientes_empresa")
  movimientos_puntos movimientos_puntos[]
  ordenes            ordenes[]

  @@unique([empresa_id, telefono], map: "uq_clientes_empresa_tel", where: raw("deleted_at IS NULL"))
  @@index([empresa_id], map: "idx_clientes_empresa")
  @@index([telefono], map: "idx_clientes_telefono")
  @@index([empresa_id, visitas], map: "idx_clientes_tenant_visitas")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model config_lealtad {
  empresa_id        String   @id(map: "pk_config_lealtad") @db.Uuid
  puntos_por_moneda Decimal  @default(1.00) @db.Decimal(10, 2)
  caducidad_meses   Int      @default(12)
  umbral_frecuente  Int      @default(5)
  umbral_vip        Int      @default(20)
  updated_at        DateTime @default(now()) @db.Timestamptz(6)
  empresas          empresas @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_config_empresa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimientos_puntos {
  id          String                 @id(map: "pk_movpuntos") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cliente_id  String                 @db.Uuid
  empresa_id  String                 @db.Uuid
  sucursal_id String                 @db.Uuid
  tipo        tipo_movimiento_puntos
  puntos      Int
  orden_id    String?                @db.Uuid
  motivo      String?
  created_at  DateTime               @default(now()) @db.Timestamptz(6)
  clientes    clientes               @relation(fields: [cliente_id], references: [id], onDelete: Cascade, map: "fk_movpuntos_cliente")
  empresas    empresas               @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_movpuntos_empresa")
  ordenes     ordenes?               @relation(fields: [orden_id], references: [id], map: "fk_movpuntos_orden")
  sucursales  sucursales             @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_movpuntos_sucursal")

  @@index([cliente_id], map: "idx_movpuntos_cliente")
  @@index([empresa_id], map: "idx_movpuntos_empresa")
  @@index([sucursal_id], map: "idx_movpuntos_sucursal")
  @@index([empresa_id, created_at(sort: Desc)], map: "idx_movpuntos_tenant_fecha")
}

enum segmento_cliente {
  NUEVO
  FRECUENTE
  VIP
}

enum tipo_movimiento_puntos {
  GANANCIA
  CANJE
  CADUCIDAD
}
