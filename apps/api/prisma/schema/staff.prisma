// Esquema Prisma del modulo staff.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asistencias {
  id           String            @id(map: "pk_asistencias") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id   String            @db.Uuid
  sucursal_id  String            @db.Uuid
  empleado_id  String            @db.Uuid
  fecha        DateTime          @db.Date
  hora_entrada DateTime?         @db.Timestamptz(6)
  hora_salida  DateTime?         @db.Timestamptz(6)
  estado       estado_asistencia @default(PRESENTE)
  fuente       String            @default("PIN")
  created_at   DateTime          @default(now()) @db.Timestamptz(6)
  empleados    empleados         @relation(fields: [empleado_id], references: [id], onDelete: Cascade, map: "fk_asis_empleado")
  empresas     empresas          @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_asis_empresa")
  sucursales   sucursales        @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_asis_sucursal")

  @@unique([empleado_id, fecha], map: "uq_asis_empleado_fecha")
  @@index([empleado_id], map: "idx_asis_empleado")
  @@index([empresa_id], map: "idx_asis_empresa")
  @@index([sucursal_id], map: "idx_asis_sucursal")
  @@index([empresa_id, sucursal_id, fecha(sort: Desc)], map: "idx_asis_tenant_fecha")
}

model empleados {
  id                String              @id(map: "pk_empleados") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id        String              @db.Uuid
  sucursal_id       String              @db.Uuid
  usuario_id        String?             @unique(map: "uq_empleados_usuario", where: raw("(usuario_id IS NOT NULL)")) @db.Uuid
  nombre            String
  rol_id            String              @db.Uuid
  en_turno          Boolean             @default(false)
  fecha_ingreso     DateTime?           @db.Date
  activo            Boolean             @default(true)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  updated_at        DateTime            @default(now()) @db.Timestamptz(6)
  deleted_at        DateTime?           @db.Timestamptz(6)
  deleted_by        String?             @db.Uuid
  asistencias       asistencias[]
  empresas          empresas            @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_empleados_empresa")
  roles_empresa     roles_empresa       @relation(fields: [rol_id], references: [id], map: "fk_empleados_rol")
  sucursales        sucursales          @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_empleados_sucursal")
  usuarios          usuarios?           @relation(fields: [usuario_id], references: [id], map: "fk_empleados_usuario")
  repartos_propinas repartos_propinas[]
  turnos_plan       turnos_plan[]

  @@index([empresa_id], map: "idx_empleados_empresa")
  @@index([rol_id], map: "idx_empleados_rol")
  @@index([sucursal_id], map: "idx_empleados_sucursal")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model pozos_propinas {
  id                String              @id(map: "pk_pozos") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id        String              @db.Uuid
  sucursal_id       String              @db.Uuid
  fecha             DateTime            @db.Date
  total             Decimal             @default(0) @db.Decimal(12, 2)
  nro_beneficiarios Int                 @default(0)
  estado            estado_pozo_propina @default(CALCULADO)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  empresas          empresas            @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_pozos_empresa")
  sucursales        sucursales          @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_pozos_sucursal")
  repartos_propinas repartos_propinas[]

  @@unique([sucursal_id, fecha], map: "uq_pozos_sucursal_fecha")
  @@index([empresa_id], map: "idx_pozos_empresa")
  @@index([sucursal_id], map: "idx_pozos_sucursal")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model repartos_propinas {
  pozo_id        String         @db.Uuid
  empleado_id    String         @db.Uuid
  monto          Decimal        @db.Decimal(12, 2)
  presente       Boolean        @default(true)
  empleados      empleados      @relation(fields: [empleado_id], references: [id], onDelete: Cascade, map: "fk_rep_empleado")
  pozos_propinas pozos_propinas @relation(fields: [pozo_id], references: [id], onDelete: Cascade, map: "fk_rep_pozo")

  @@id([pozo_id, empleado_id])
  @@index([empleado_id], map: "idx_rep_empleado")
}

model turnos_plan {
  id          String       @id(map: "pk_turnosplan") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id  String       @db.Uuid
  sucursal_id String       @db.Uuid
  empleado_id String       @db.Uuid
  fecha       DateTime     @db.Date
  bloque      bloque_turno
  created_at  DateTime     @default(now()) @db.Timestamptz(6)
  empleados   empleados    @relation(fields: [empleado_id], references: [id], onDelete: Cascade, map: "fk_tp_empleado")
  empresas    empresas     @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_tp_empresa")
  sucursales  sucursales   @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_tp_sucursal")

  @@unique([empleado_id, fecha, bloque], map: "uq_tp_empleado_fecha_bloque")
  @@index([empleado_id], map: "idx_tp_empleado")
  @@index([empresa_id], map: "idx_tp_empresa")
  @@index([sucursal_id], map: "idx_tp_sucursal")
  @@index([sucursal_id, fecha], map: "idx_tp_sucursal_fecha")
}

enum bloque_turno {
  MANANA
  TARDE
  NOCHE
  DESCANSO
}

enum estado_asistencia {
  PRESENTE
  TARDANZA
  FALTA
  DESCANSO
}

enum estado_pozo_propina {
  CALCULADO
  REPARTIDO
}
