// Esquema Prisma del modulo expenses.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model gastos {
  id               String             @id(map: "pk_gastos") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id       String             @db.Uuid
  sucursal_id      String             @db.Uuid
  concepto         String
  monto            Decimal            @db.Decimal(12, 2)
  categoria        categoria_gasto
  estado_pago      estado_pago_gasto  @default(PENDIENTE)
  pagado_en_caja   Boolean            @default(false)
  turno_id         String?            @db.Uuid
  proveedor_id     String?            @db.Uuid
  vencimiento      DateTime?          @db.Date
  registrado_por   String?            @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  empresas         empresas           @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_gastos_empresa")
  proveedores      proveedores?       @relation(fields: [proveedor_id], references: [id], map: "fk_gastos_proveedor")
  usuarios         usuarios?          @relation(fields: [registrado_por], references: [id], map: "fk_gastos_registrado")
  sucursales       sucursales         @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_gastos_sucursal")
  turnos_caja      turnos_caja?       @relation(fields: [turno_id], references: [id], map: "fk_gastos_turno")
  movimientos_caja movimientos_caja[]

  @@index([empresa_id], map: "idx_gastos_empresa")
  @@index([proveedor_id], map: "idx_gastos_proveedor")
  @@index([sucursal_id], map: "idx_gastos_sucursal")
  @@index([turno_id], map: "idx_gastos_turno")
  @@index([empresa_id, sucursal_id, created_at(sort: Desc)], map: "idx_gastos_tenant_fecha")
}

enum categoria_gasto {
  INSUMOS
  SERVICIOS
  PERSONAL
  ALQUILER
  MARKETING
  OTROS
}

enum estado_pago_gasto {
  PAGADO
  PENDIENTE
}
