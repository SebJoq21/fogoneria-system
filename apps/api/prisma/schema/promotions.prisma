// Esquema Prisma del modulo promotions.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model canjes_cupones {
  id               String     @id(map: "pk_canjes") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cupon_id         String     @db.Uuid
  orden_id         String     @db.Uuid
  empresa_id       String     @db.Uuid
  sucursal_id      String     @db.Uuid
  monto_descontado Decimal    @db.Decimal(12, 2)
  aplicado_por     String?    @db.Uuid
  aplicado_at      DateTime   @default(now()) @db.Timestamptz(6)
  usuarios         usuarios?  @relation(fields: [aplicado_por], references: [id], map: "fk_canjes_aplicado")
  cupones          cupones    @relation(fields: [cupon_id], references: [id], onDelete: Cascade, map: "fk_canjes_cupon")
  empresas         empresas   @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_canjes_empresa")
  ordenes          ordenes    @relation(fields: [orden_id], references: [id], onDelete: Cascade, map: "fk_canjes_orden")
  sucursales       sucursales @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_canjes_sucursal")

  @@unique([cupon_id, orden_id], map: "uq_canjes_cupon_orden")
  @@index([cupon_id], map: "idx_canjes_cupon")
  @@index([empresa_id], map: "idx_canjes_empresa")
  @@index([orden_id], map: "idx_canjes_orden")
  @@index([sucursal_id], map: "idx_canjes_sucursal")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model combos {
  id             String           @id(map: "pk_combos") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id     String           @db.Uuid
  nombre         String
  descripcion    String?
  precio_fijo    Decimal          @db.Decimal(12, 2)
  activo         Boolean          @default(true)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  updated_at     DateTime         @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?        @db.Timestamptz(6)
  deleted_by     String?          @db.Uuid
  empresas       empresas         @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_combos_empresa")
  combos_platos  combos_platos[]
  detalles_orden detalles_orden[]

  @@unique([empresa_id, nombre], map: "uq_combos_empresa_nombre", where: raw("deleted_at IS NULL"))
  @@index([empresa_id], map: "idx_combos_empresa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model combos_platos {
  combo_id String @db.Uuid
  plato_id String @db.Uuid
  cantidad Int    @default(1)
  combos   combos @relation(fields: [combo_id], references: [id], onDelete: Cascade, map: "fk_cp_combo")
  platos   platos @relation(fields: [plato_id], references: [id], map: "fk_cp_plato")

  @@id([combo_id, plato_id])
  @@index([plato_id], map: "idx_cp_plato")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model cupones {
  id             String               @id(map: "pk_cupones") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id     String               @db.Uuid
  codigo         String
  tipo_descuento tipo_descuento_cupon
  valor          Decimal              @db.Decimal(12, 2)
  limite_usos    Int
  usos_actuales  Int                  @default(0)
  vencimiento    DateTime             @db.Date
  activo         Boolean              @default(true)
  created_at     DateTime             @default(now()) @db.Timestamptz(6)
  updated_at     DateTime             @default(now()) @db.Timestamptz(6)
  deleted_at     DateTime?            @db.Timestamptz(6)
  deleted_by     String?              @db.Uuid
  canjes_cupones canjes_cupones[]
  empresas       empresas             @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_cupones_empresa")
  ordenes        ordenes[]

  @@unique([empresa_id, codigo], map: "uq_cupones_empresa_codigo", where: raw("deleted_at IS NULL"))
  @@index([empresa_id], map: "idx_cupones_empresa")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reglas_horarias_promos {
  id          String   @id(map: "pk_reglas") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id  String   @db.Uuid
  nombre      String
  beneficio   String
  dias_semana Int[]    @default([1, 2, 3, 4, 5])
  hora_inicio DateTime @db.Time(6)
  hora_fin    DateTime @db.Time(6)
  activa      Boolean  @default(true)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @db.Timestamptz(6)
  deleted_at  DateTime? @db.Timestamptz(6)
  deleted_by  String?  @db.Uuid
  empresas    empresas @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_reglas_empresa")

  @@unique([empresa_id, nombre], map: "uq_reglas_empresa_nombre", where: raw("deleted_at IS NULL"))
  @@index([empresa_id], map: "idx_reglas_empresa")
}

enum tipo_descuento_cupon {
  PORCENTAJE
  MONTO
}
