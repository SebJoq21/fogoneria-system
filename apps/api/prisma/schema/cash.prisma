// Esquema Prisma del modulo cash.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movimientos_caja {
  id          String               @id(map: "pk_movcaja") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id  String               @db.Uuid
  turno_id    String               @db.Uuid
  tipo        tipo_movimiento_caja
  concepto    String
  monto       Decimal              @db.Decimal(12, 2)
  metodo      metodo_pago
  orden_id    String?              @db.Uuid
  gasto_id    String?              @db.Uuid
  actor_id    String?              @db.Uuid
  created_at  DateTime             @default(now()) @db.Timestamptz(6)
  usuarios    usuarios?            @relation(fields: [actor_id], references: [id], map: "fk_movcaja_actor")
  empresas    empresas             @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_movcaja_empresa")
  gastos      gastos?              @relation(fields: [gasto_id], references: [id], map: "fk_movcaja_gasto")
  ordenes     ordenes?             @relation(fields: [orden_id], references: [id], map: "fk_movcaja_orden")
  turnos_caja turnos_caja          @relation(fields: [turno_id], references: [id], onDelete: Cascade, map: "fk_movcaja_turno")

  @@index([empresa_id], map: "idx_movcaja_empresa")
  @@index([gasto_id], map: "idx_movcaja_gasto")
  @@index([orden_id], map: "idx_movcaja_orden")
  @@index([turno_id], map: "idx_movcaja_turno")
  @@index([empresa_id, created_at(sort: Desc)], map: "idx_movcaja_tenant_fecha")
  @@index([turno_id, created_at], map: "idx_movcaja_turno_fecha")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model turnos_caja {
  id               String             @id(map: "pk_turnos") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id       String             @db.Uuid
  sucursal_id      String             @db.Uuid
  cajero_id        String?            @db.Uuid
  apertura_at      DateTime           @default(now()) @db.Timestamptz(6)
  cierre_at        DateTime?          @db.Timestamptz(6)
  fondo_apertura   Decimal            @default(0) @db.Decimal(12, 2)
  ingresos_total   Decimal            @default(0) @db.Decimal(12, 2)
  egresos_total    Decimal            @default(0) @db.Decimal(12, 2)
  saldo            Decimal?           @db.Decimal(12, 2)
  efectivo_contado Decimal?           @db.Decimal(12, 2)
  diferencia       Decimal?           @db.Decimal(12, 2)
  observaciones    String?
  estado           estado_turno_caja  @default(ABIERTO)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  gastos           gastos[]
  movimientos_caja movimientos_caja[]
  usuarios         usuarios?          @relation(fields: [cajero_id], references: [id], map: "fk_turnos_cajero")
  empresas         empresas           @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_turnos_empresa")
  sucursales       sucursales         @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_turnos_sucursal")

  @@index([empresa_id], map: "idx_turnos_empresa")
  @@index([sucursal_id, estado], map: "idx_turnos_estado")
  @@index([sucursal_id], map: "idx_turnos_sucursal")
  @@unique([empresa_id, sucursal_id], map: "uq_turnos_abierto_sucursal", where: raw("estado = 'ABIERTO'"))
  @@index([empresa_id, sucursal_id, estado], map: "idx_turnos_tenant_sucursal_estado")
  @@index([empresa_id, apertura_at(sort: Desc)], map: "idx_turnos_tenant_fecha")
}

enum estado_turno_caja {
  ABIERTO
  CERRADO
}

enum metodo_pago {
  EFECTIVO
  TARJETA
  YAPE
  TRANSFERENCIA
}

enum tipo_movimiento_caja {
  INGRESO
  EGRESO
}
