// Esquema Prisma del modulo receipts.
// Los modelos pueden referenciar modelos de otros archivos: Prisma los
// combina antes de generar el cliente y de calcular migraciones.

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model comprobantes {
  id                                          String             @id(map: "pk_comprobantes") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id                                  String             @db.Uuid
  sucursal_id                                 String             @db.Uuid
  tipo                                        tipo_comprobante   @default(BOLETA)
  serie_numero                                String
  orden_id                                    String             @db.Uuid
  cliente_ref                                 String?
  total                                       Decimal            @db.Decimal(12, 2)
  estado                                      estado_comprobante @default(PAGADA)
  emitido_por                                 String?            @db.Uuid
  anulado_por                                 String?            @db.Uuid
  anulado_at                                  DateTime?          @db.Timestamptz(6)
  motivo_anulacion                            String?
  created_at                                  DateTime           @default(now()) @db.Timestamptz(6)
  usuarios_comprobantes_anulado_porTousuarios usuarios?          @relation("comprobantes_anulado_porTousuarios", fields: [anulado_por], references: [id], map: "fk_comp_anulado")
  usuarios_comprobantes_emitido_porTousuarios usuarios?          @relation("comprobantes_emitido_porTousuarios", fields: [emitido_por], references: [id], map: "fk_comp_emitido")
  empresas                                    empresas           @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_comp_empresa")
  ordenes                                     ordenes            @relation(fields: [orden_id], references: [id], map: "fk_comp_orden")
  sucursales                                  sucursales         @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_comp_sucursal")

  @@unique([empresa_id, serie_numero], map: "uq_comp_empresa_serie")
  @@index([empresa_id], map: "idx_comp_empresa")
  @@index([orden_id], map: "idx_comp_orden")
  @@index([sucursal_id], map: "idx_comp_sucursal")
  @@index([empresa_id, sucursal_id, created_at(sort: Desc)], map: "idx_comp_tenant_fecha")
  @@index([empresa_id, estado, created_at(sort: Desc)], map: "idx_comp_tenant_estado")
}

enum estado_comprobante {
  PAGADA
  ANULADA
}

enum tipo_comprobante {
  BOLETA
  FACTURA
  TICKET
}
