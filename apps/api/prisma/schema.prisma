  sucursales  sucursales? @relation(fields: [sucursal_id], references: [id], map: "fk_aud_sucursal")
  usuarios    usuarios?   @relation(fields: [usuario_id], references: [id], map: "fk_aud_usuario")

  @@index([empresa_id], map: "idx_aud_empresa")
  @@index([entidad, entidad_id], map: "idx_aud_entidad")
  @@index([sucursal_id], map: "idx_aud_sucursal")
  @@index([usuario_id], map: "idx_aud_usuario")
  @@index([empresa_id, created_at(sort: Desc)], map: "idx_aud_tenant_fecha")
