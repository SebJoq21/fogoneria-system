/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model asistencias {
  id           String            @id(map: "pk_asistencias") @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  empresa_id   String            @db.Uuid
  sucursal_id  String            @db.Uuid
  empleado_id  String            @db.Uuid
  fecha        DateTime          @db.Date
  hora_entrada DateTime?         @db.Timestamptz(6)
  hora_salida  DateTime?         @db.Timestamptz(6)
  estado       estado_asistencia @default(PRESENTE)
  fuente       String            @default("PIN")
  created_at   DateTime          @default(now()) @db.Timestamptz(6)
  empleados    empleados         @relation(fields: [empleado_id], references: [id], onDelete: Cascade, map: "fk_asis_empleado")
  empresas     empresas          @relation(fields: [empresa_id], references: [id], onDelete: Cascade, map: "fk_asis_empresa")
  sucursales   sucursales        @relation(fields: [sucursal_id], references: [id], onDelete: Cascade, map: "fk_asis_sucursal")

  @@unique([empleado_id, fecha], map: "uq_asis_empleado_fecha")
  @@index([empleado_id], map: "idx_asis_empleado")
  @@index([empresa_id], map: "idx_asis_empresa")
  @@index([sucursal_id], map: "idx_asis_sucursal")
  @@index([empresa_id, sucursal_id, fecha(sort: Desc)], map: "idx_asis_tenant_fecha")
}

