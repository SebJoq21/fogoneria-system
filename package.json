{
  "name": "fogoneria-system",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File ./db/scripts/backup/backup.ps1",
    "db:restore": "powershell -NoProfile -ExecutionPolicy Bypass -File ./db/scripts/backup/restore.ps1"
  },
  "devDependencies": {
    "@babel/preset-typescript": "8.0.1",
    "prettier": "3.9.6",
    "turbo": "^2.10.12",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
