# Fogonería System — variables del Docker Compose local.
# Copia este archivo a .env (está ignorado por git) antes de `docker compose up`:
#   cp .env.example .env
#
# Los valores de abajo son SOLO para desarrollo local. En staging/producción
# genera secretos propios (openssl rand -base64 32) y no reutilices estos.
# Usa contraseñas con caracteres URL-safe: se interpolan en DATABASE_URL.

# PostgreSQL local (contenedor `fogoneria-postgres`)
POSTGRES_PORT=5433
POSTGRES_DB=fogoneria_db
POSTGRES_USER=fogoneria_app
POSTGRES_PASSWORD=fogoneria_app

# Roles de aplicación creados por db/scripts/rls/000-roles.sql.
# `fogoneria_rls` no tiene BYPASSRLS (API de negocio); `fogoneria_saas` sí
# (auth, onboarding y consola SaaS).
POSTGRES_RLS_PASSWORD=fogoneria_rls
POSTGRES_SAAS_PASSWORD=fogoneria_saas

# Secretos de la API y del BFF web (mínimo 32 caracteres).
JWT_SECRET="dev-only-jwt-secret-change-me-32-chars"
SESSION_SECRET="dev-only-session-secret-change-me-32chars"
